# ---------- Application ----------
APP_NAME=Retail Staff Shift Scheduling Platform
ENVIRONMENT=development
DEBUG=true

# ---------- Database ----------
# Local PostgreSQL 15. Production must use a managed PostgreSQL instance.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/retail_scheduling
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---------- JWT ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Never commit a real value. The application refuses to start in production
# if this is left at its default.
JWT_SECRET_KEY=CHANGE_ME_development_only_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- URLs / CORS ----------
# Comma-separated list of browser origins allowed to call the API.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ---------- Bootstrap manager ----------
# Used only by `python -m scripts.create_manager` to provision the very first
# manager account. No account is created automatically at startup.
MANAGER_EMAIL=manager@example.com

# ---------- Attendance rules ----------
ATTENDANCE_GRACE_MINUTES=10
MISSING_CLOCKOUT_GRACE_MINUTES=120

# ---------- Scheduling business rules ----------
# These are configurable business rules, not statutory labour law limits.
MAX_WEEKLY_HOURS=40
MIN_REST_HOURS_BETWEEN_SHIFTS=11
MAX_CONSECUTIVE_WORK_DAYS=6
OVERTIME_WARNING_HOURS=36
MIN_EMPLOYEE_STATUS_WARNING_HOURS=32

# ---------- Email ----------
# Leave EMAIL_HOST empty to disable delivery. Message rendering still works,
# notifications are still stored, and /api/health reports email_enabled=false.
# The system never pretends to send an email it did not send.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_USE_TLS=true

# ---------- Rate limiting (per-process, in-memory) ----------
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ENABLED=true

# ---------- Pagination ----------
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ---------- Frontend ----------
# Set in frontend/.env (or frontend/.env.local), NOT here.
# VITE_API_BASE_URL=http://localhost:8000/api